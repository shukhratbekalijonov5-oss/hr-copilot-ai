PAYMENT_PROVIDER=MOCK

# Shared service-to-service credential for /internal/**.
PAYMENT_INTERNAL_TOKEN=

# Mock provider webhook HMAC secret for local/dev only.
PAYMENT_MOCK_WEBHOOK_SECRET=

# Toss Payments sandbox/test provider. Leave empty unless PAYMENT_PROVIDER=TOSS.
TOSS_PAYMENTS_BASE_URL=https://api.tosspayments.com
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# Registered with Toss: where Toss redirects the browser after the hosted
# window (these point at THIS service's /callbacks/toss/* endpoints).
TOSS_PAYMENTS_SUCCESS_URL=
TOSS_PAYMENTS_FAIL_URL=
# Where /callbacks/toss/* redirect the BROWSER afterwards (frontend pages).
TOSS_PAYMENTS_BROWSER_SUCCESS_URL=
TOSS_PAYMENTS_BROWSER_FAIL_URL=
TOSS_PAYMENTS_METHOD=FOREIGN_EASY_PAY
TOSS_PAYMENTS_FOREIGN_EASY_PAY_PROVIDER=PAYPAL
TOSS_PAYMENTS_CONNECT_TIMEOUT_MS=2000
TOSS_PAYMENTS_REQUEST_TIMEOUT_MS=5000
