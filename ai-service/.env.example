# ---------------------------------------------------------------------------
# HR Copilot AI service — environment
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored.
# Every value here is a PLACEHOLDER — never commit real secrets.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Port the FastAPI service listens on.
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Internal service authentication
#
# Shared secret between the NestJS backend and this service, sent as the
# X-Internal-Service-Token header on every /internal/* request.
#
# This is NOT a user JWT and must never be one. Generate with:
#   openssl rand -base64 48
#
# The SAME value must be set as INTERNAL_SERVICE_TOKEN in backend/.env.
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=replace-me-with-a-long-random-shared-secret

# ---------------------------------------------------------------------------
# Progress callback
#
# The backend endpoint that receives real per-stage progress as each pipeline
# stage completes, so document status is observed rather than guessed.
# Authenticated with the same INTERNAL_SERVICE_TOKEN. Leave empty to disable.
# ---------------------------------------------------------------------------
PROGRESS_CALLBACK_URL=http://localhost:3001/api/internal/processing/progress

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_chunks
# The ACTIVE collection is QDRANT_COLLECTION + "_v" + this number, e.g.
# resume_chunks_v1. Changing EMBEDDING_MODEL changes the vector width, so bump
# this and reindex into the new collection rather than rewriting the live one.
# See docs/reindexing.md.
QDRANT_COLLECTION_VERSION=1

# ---------------------------------------------------------------------------
# Embeddings (PyTorch / sentence-transformers, runs locally on CPU)
#
# Multilingual by default so Korean and English resumes share one vector space.
# Changing this changes the vector dimension; the collection must be recreated.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=256

# ---------------------------------------------------------------------------
# Reranking (PyTorch cross-encoder, second retrieval stage)
# ---------------------------------------------------------------------------
# Multilingual cross-encoder. Note: the ms-marco-MiniLM-L-6-v2 / -L6-v2
# checkpoints emit NaN logits under transformers 4.57.x and cannot be used.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_POOL=30

# ---------------------------------------------------------------------------
# Grounded generation (LLM)
#
# Provider-neutral: application code depends on the GenerationClient interface,
# never on a vendor SDK, so switching provider is a config change.
#
# Secret precedence (decided in Settings.resolved_api_key):
#   1. LLM_API_KEY            - generic override, wins when set
#   2. <PROVIDER>_API_KEY     - the provider's own variable
#
# With no key for the active provider, generation is DISABLED: /internal/rag
# and the summary/interview endpoints return 503 generation_disabled instead of
# answering from the model's own knowledge. Retrieval, semantic search and JD
# evidence mapping are unaffected and keep working.
#
# This service is the ONLY component that talks to the LLM. The browser and the
# NestJS backend never see this key. Never commit a real key. Never log it.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Leave empty to use the provider default (gemini-3.6-flash / claude-opus-5).
LLM_MODEL=
LLM_API_KEY=

# Provider-specific credentials. Set only the one matching LLM_PROVIDER.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# Grounded extraction is a reporting task; determinism beats creativity.
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Requirement mapping (JD -> candidate evidence)
#
# Decision boundaries between EVIDENCE_FOUND / NEEDS_HUMAN_REVIEW /
# NO_EVIDENCE_FOUND. Measured against fixtures — see
# docs/evidence-thresholding.md. These are NOT a candidate score, NOT a fit
# percentage, and are never returned to a client.
# ---------------------------------------------------------------------------
MAPPING_LEXICAL_FOUND=0.6
MAPPING_SEMANTIC_REVIEW=0.30
MAPPING_MAX_EVIDENCE=3
MAPPING_CANDIDATE_POOL=8

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Tuned for resumes (short sections). Larger values measurably hurt retrieval.
CHUNK_TARGET_CHARS=400
CHUNK_OVERLAP_CHARS=80
CHUNK_MIN_SPLIT_CHARS=350

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=52428800

# Load models at startup instead of on first request.
EAGER_LOAD_MODELS=false
