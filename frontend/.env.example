# Origin of the NestJS application API.
# The frontend talks ONLY to this service — never to Qdrant, Redis, or the
# Python AI service directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# No other variables are required by the frontend.
#
# Never add secrets here or to any NEXT_PUBLIC_* variable: everything prefixed
# with NEXT_PUBLIC_ is inlined into the browser bundle. Storage keys, the JWT
# signing secret, database URLs, INTERNAL_SERVICE_TOKEN and LLM API keys belong
# to the backend's own environment only.

# Portfolio demo mode — OFF unless this is exactly "true".
#
# Shows the demo plan switch, which changes a plan WITHOUT taking payment. It
# is the browser-facing half of PORTFOLIO_DEMO_MODE, which the NestJS BFF and
# the payment service read under that same name; all three must be on for a
# demo switch to actually change anything.
#
# Leave it UNSET when building the image. Next inlines NEXT_PUBLIC_* values at
# build time, so baking "true" in makes it impossible to turn off without
# rebuilding; unset at build, it compiles to a real process.env read and the
# deployment can set it on the container.
#
# This is not a secret and not an authorization boundary — it only decides
# whether the control is drawn.
# NEXT_PUBLIC_PORTFOLIO_DEMO_MODE=true
