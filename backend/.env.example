# ---------------------------------------------------------------------------
# HR Copilot AI — backend environment
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored.
# Every value here is a PLACEHOLDER — never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Backend HTTP port. The Next.js frontend owns 3000 locally, so the API
# defaults to 3001. Override freely; nothing hardcodes a port.
PORT=3001

# Allowed browser origin for CORS. Must be an explicit origin, not '*'.
FRONTEND_URL=http://localhost:3000

# Path prefix for the REST API. /health/live and /health/ready sit outside it.
API_PREFIX=api

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_copilot?schema=public

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
#
# SECRET_TOKEN is the single backend auth signing secret (there is deliberately
# no separate JWT_SECRET). Minimum 32 characters — generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
SECRET_TOKEN=replace-me-with-a-long-random-value-at-least-32-chars
TOKEN_TTL=1d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Storage
#
# STORAGE_DRIVER=local writes to STORAGE_LOCAL_ROOT and needs no credentials.
# STORAGE_DRIVER=r2 requires all four R2_* values below.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_FILE_SIZE_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------------------------------------------------------------------------
# AI service (Python FastAPI) — not implemented yet.
#
# Leave EMPTY until the service exists. While empty, document processing jobs
# fail fast with a clear message instead of fabricating parse results.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=120000

# Shared credential for backend <-> AI service calls, sent as the
# X-Internal-Service-Token header. This is a SERVICE credential and is
# deliberately separate from SECRET_TOKEN: a user session secret must not
# double as a service one, and a recruiter JWT is never forwarded to the AI
# service. Must match INTERNAL_SERVICE_TOKEN in ai-service/.env.
#   openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=replace-me-with-a-long-random-shared-secret

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
