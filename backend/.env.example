# ---------------------------------------------------------------------------
# HR Copilot AI — backend environment
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored.
# Every value here is a PLACEHOLDER — never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Backend HTTP port. The Next.js frontend owns 3000 locally, so the API
# defaults to 3001. Override freely; nothing hardcodes a port.
PORT=3001

# Allowed browser origin for CORS. Must be an explicit origin, not '*'.
FRONTEND_URL=http://localhost:3000

# Path prefix for the REST API. /health/live and /health/ready sit outside it.
API_PREFIX=api

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_copilot?schema=public

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
#
# SECRET_TOKEN is the single backend auth signing secret (there is deliberately
# no separate JWT_SECRET). Minimum 32 characters — generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
SECRET_TOKEN=replace-me-with-a-long-random-value-at-least-32-chars
TOKEN_TTL=15m
# Absolute refresh-session lifetime; rotation never extends it.
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Storage
#
# STORAGE_DRIVER=local writes to STORAGE_LOCAL_ROOT and needs no credentials.
# STORAGE_DRIVER=r2 requires all four R2_* values below.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_FILE_SIZE_BYTES=52428800
SIGNED_URL_TTL_SECONDS=900

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------------------------------------------------------------------------
# AI service (Python FastAPI) — not implemented yet.
#
# Leave EMPTY until the service exists. While empty, document processing jobs
# fail fast with a clear message instead of fabricating parse results.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=120000

# Shared credential for backend <-> AI service calls, sent as the
# X-Internal-Service-Token header. This is a SERVICE credential and is
# deliberately separate from SECRET_TOKEN: a user session secret must not
# double as a service one, and a recruiter JWT is never forwarded to the AI
# service. Must match INTERNAL_SERVICE_TOKEN in ai-service/.env.
#   openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=replace-me-with-a-long-random-shared-secret

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Candidate professional links (web ingestion)
# ---------------------------------------------------------------------------
# Off by default. When true, a page whose content is unreadable without
# JavaScript is rendered in a headless browser as a LAST resort — after the
# static fetch and the embedded-hydration-payload reader have both failed.
#
# It requires the OPTIONAL `playwright` package and its Chromium download
# (~300 MB), and it executes third-party JavaScript, so it is a deliberate
# opt-in rather than a default. With it off, such a page fails cleanly as
# NO_MEANINGFUL_CONTENT and the candidate is told why.
#
# Every SSRF rule still applies to a rendered page: each subresource request is
# re-validated (protocol, port, hostname, resolved IP), downloads are blocked,
# and the browser context is ephemeral. See backend/docs/evidence-sources.md.
#
# All other web-ingestion bounds (timeouts, byte caps, page and redirect
# limits) are code constants, not environment variables — they are security
# limits, and a deployment must not be able to widen them by accident. See
# src/web-ingestion/web-ingestion.limits.ts.
WEB_RENDER_ENABLED=false

# --- Exchange rates (optional) ----------------------------------------------
# Used ONLY to compare a job's salary against what a candidate asked for when
# the two are quoted in different currencies. Leave both unset and the product
# works: cross-currency salaries report "could not be compared", every job
# still ranks, and nothing is hidden.
#
# The URL is a template — {key} and {base} are substituted — and is separate
# from the key on purpose: an API key does not identify its provider, and
# hard-coding a guessed endpoint would send a real credential to a service it
# may not belong to. Set it to your provider's "latest rates" endpoint.
#
# This deployment uses ExchangeRate-API:
#   EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/{key}/latest/{base}
# Any provider returning a JSON map of ISO-4217 codes to rates works; the
# response is normalized in src/fx/fx-rate.provider.ts, not assumed.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=
# Currency the provider quotes against, and how often to refresh (ms).
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_REFRESH_MS=1800000

# --- External job ingestion (Task 4B.1) -------------------------------------
# Public Greenhouse job boards to read, comma-separated board tokens.
# Optionally `token:Label`. Empty (the default) registers no provider and makes
# no network call at all.
#
# The Greenhouse Job Board API read path is PUBLIC and needs no credential.
# There is deliberately no key setting here: the private Harvest API carries
# candidate and recruiting data this product has no business reading.
EXTERNAL_GREENHOUSE_BOARDS=
# Repeating background sweeps. Off by default — a schedule is a standing
# commitment to call someone else's servers, so it is opted into, not inherited.
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SYNC_INTERVAL_MS=21600000
# Lifecycle ageing pass (DB-local, no provider HTTP): marks over-aged ACTIVE
# jobs STALE and past-deadline jobs EXPIRED. Scheduled only while
# EXTERNAL_SYNC_ENABLED=true. Default 1h; clamped to [300000, 86400000].
EXTERNAL_REVALIDATE_INTERVAL_MS=3600000
EXTERNAL_REQUEST_TIMEOUT_MS=20000
EXTERNAL_MAX_ATTEMPTS=3

# Public Lever job sites to read, comma-separated site slugs (`slug:Label`).
# Empty (the default) registers no Lever provider and makes no network call.
#
# The Lever public Postings API read path needs NO credential. There is
# deliberately no key setting: the authenticated Lever API carries candidate
# and recruiting data this product has no business reading.
EXTERNAL_LEVER_SITES=
EXTERNAL_LEVER_PAGE_SIZE=100

# Public Ashby job boards to read, comma-separated board names (`name:Label`).
# Empty (the default) registers no Ashby provider and makes no network call.
#
# The Ashby public Job Postings API read path needs NO credential. There is
# deliberately no key setting: the authenticated RPC API carries candidate and
# recruiting data this product has no business reading.
EXTERNAL_ASHBY_BOARDS=

# --- Company careers pages -------------------------------------------------
# Approved source IDs from src/external-jobs/providers/company-careers/
# company-careers.catalogue.ts — NEVER URLs. Each catalogue entry carries the
# access review (robots rules, how the page serves its jobs, and whether it may
# be read at all); an id that is not in the catalogue is ignored, and a URL
# pasted here is simply an unknown id. Enabling a new company is a reviewed
# code change, not an environment edit, because someone has to look at the
# site's access rules and say yes.
# Known ids: vercel-careers, linear-careers
#            (figma-careers and ramp-careers exist but are reviewed OFF)
EXTERNAL_COMPANY_CAREERS_SOURCES=

# Authorized Ninehire workspaces (Task 4B.4). AUTHENTICATED, per-workspace API.
#
# Format: scope:SECRET_ENV_VAR_NAME, comma-separated. The second half names an
# environment variable — it is NEVER the key. Configure a workspace only if you
# are authorized to use its API. Empty (the default) registers no provider and
# makes no request.
#
#   EXTERNAL_NINEHIRE_SOURCES=acme:NINEHIRE_KEY_ACME
#   NINEHIRE_KEY_ACME=<set this in a real environment, never in this file>
EXTERNAL_NINEHIRE_SOURCES=
EXTERNAL_NINEHIRE_PAGE_SIZE=100
EXTERNAL_NINEHIRE_DETAIL_BUDGET=200

# --- Entitlements source (candidate FREE/PRO/MAX) ---------------------------
# 'db' keeps the transitional candidate_accounts.plan column (development).
# 'payment-service' reads the Java Payment Service — the billing authority.
ENTITLEMENTS_SOURCE=db
PAYMENT_SERVICE_URL=http://localhost:8081
# Shared service-to-service credential; must match payment-service config.
PAYMENT_SERVICE_INTERNAL_TOKEN=
PAYMENT_SERVICE_TIMEOUT_MS=2500
ENTITLEMENTS_CACHE_TTL_SECONDS=120
# Kafka brokers for billing.entitlement-events.v1 (comma-separated).
# Empty = consumer off (local default). Events only INVALIDATE the plan
# cache; the plan itself is always re-read from the Payment Service.
# ── Java Notification Service (notification truth) ─────────────────────────
# Internal API the BFF reads/marks notifications through.
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_INTERNAL_TOKEN=
NOTIFICATION_SERVICE_TIMEOUT_MS=2500
# Brokers for the notification outbox publisher + realtime bridge consumer.
# Empty falls back to ENTITLEMENTS_KAFKA_BROKERS.
NOTIFICATIONS_KAFKA_BROKERS=
NOTIFICATIONS_OUTBOX_POLL_MS=500
# Inbound credential the Java service presents to /internal/notification-users.
NOTIFICATION_USER_LOOKUP_TOKEN=

ENTITLEMENTS_KAFKA_BROKERS=
ENTITLEMENTS_KAFKA_CONSUMER_GROUP=hr-copilot-backend.entitlements

# Password-login lockout policy (LoginAttemptsService). Safe defaults apply
# when unset. Counters/locks live in Redis with TTLs; identifiers are hashed.
LOGIN_LOCKOUT_FIRST_THRESHOLD=5
LOGIN_LOCKOUT_FIRST_LOCK_SECONDS=900
LOGIN_LOCKOUT_SECOND_THRESHOLD=3
LOGIN_LOCKOUT_SECOND_LOCK_SECONDS=1800
LOGIN_LOCKOUT_MAX_LOCK_SECONDS=3600
LOGIN_LOCKOUT_FAILURE_WINDOW_SECONDS=1800
LOGIN_LOCKOUT_IP_WIDE_THRESHOLD=30
LOGIN_LOCKOUT_IDENTITY_WIDE_THRESHOLD=20
