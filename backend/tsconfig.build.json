{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // Tooling-only files, executed via ts-node (Prisma CLI / one-off scripts).
    // Compiling them would pull the project root into rootDir and emit
    // dist/src/main.js, breaking `node dist/main`.
    "prisma.config.ts",
    "prisma/seed.ts",
    "scripts"
  ]
}
