# ── Service ────────────────────────────────────────────────────────────────
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/hr_copilot_notifications
NOTIFICATION_INTERNAL_TOKEN=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Upstreams (service-to-service) ─────────────────────────────────────────
# NestJS backend base URL INCLUDING its /api prefix — recipient lookup.
BACKEND_BASE_URL=http://localhost:3001/api
BACKEND_INTERNAL_TOKEN=
# Payment Service internal API — expiring-subscriptions read.
PAYMENT_SERVICE_URL=http://localhost:8081
PAYMENT_INTERNAL_TOKEN=

# ── Email ──────────────────────────────────────────────────────────────────
# SMTP for real delivery (local: Mailpit). LOG is dev-only and refused in prod.
EMAIL_PROVIDER=SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_ENABLED=false
SMTP_TLS_ENABLED=false
SMTP_FROM_EMAIL=no-reply@hrcopilot.local
SMTP_FROM_NAME=HR Copilot AI
