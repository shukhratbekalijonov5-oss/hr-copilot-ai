# ── Service ────────────────────────────────────────────────────────────────
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/hr_copilot_notifications
NOTIFICATION_INTERNAL_TOKEN=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Upstreams (service-to-service) ─────────────────────────────────────────
# NestJS backend base URL INCLUDING its /api prefix — recipient lookup.
BACKEND_BASE_URL=http://localhost:3001/api
BACKEND_INTERNAL_TOKEN=
# Payment Service internal API — expiring-subscriptions read.
PAYMENT_SERVICE_URL=http://localhost:8081
PAYMENT_INTERNAL_TOKEN=

# ── Email ──────────────────────────────────────────────────────────────────
# RESEND = production (real external inboxes, HTTPS API).
# SMTP   = local/relay delivery; the dev stack points it at Mailpit.
# LOG    = dev-only, and refused outright on a production profile.
EMAIL_PROVIDER=SMTP

# Resend. Required when EMAIL_PROVIDER=RESEND — the service REFUSES TO BOOT
# without it rather than queueing emails it cannot send.
#
# NEVER commit a real value here, never paste one into Helm values, never
# put one in a frontend env file. In production it lives ONLY in the
# `notification-secrets` Kubernetes Secret, which reaches the pod via
# envFrom. If a key is ever exposed (a screenshot, a log, a chat), rotate it
# in the Resend dashboard and update that Secret — do not reuse it.
RESEND_API_KEY=
# Overridable so tests can point at a local fake; leave unset in real use.
RESEND_API_URL=https://api.resend.com/emails

# Full From header. Its domain must be verified in Resend (DKIM + the send
# CNAMEs) or the provider rejects every message with a permanent 4xx.
EMAIL_FROM=HR Copilot AI <no-reply@hrcopilot.local>
# Public web origin behind each email's single call-to-action link.
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_ENABLED=false
SMTP_TLS_ENABLED=false
SMTP_FROM_EMAIL=no-reply@hrcopilot.local
SMTP_FROM_NAME=HR Copilot AI
